/// Dot product of two Q-format vectors: `sum(a[i] * b[i])`.
/// Accumulates in `i64` (no intermediate overflow for realistic lengths),
/// rounds to nearest, then saturates to `i32`.
pub fn dot<const FRAC: i32, const N: usize>(a: [Q<FRAC>; N], b: [Q<FRAC>; N]) -> Q<FRAC>
where FRAC >= 0, FRAC <= 31
{
    var acc: i64 = 0
    var i: usize = 0
    while i < N {
        acc += (a[i].raw() as i64) * (b[i].raw() as i64)
        i += 1
    }
    if FRAC == 0 {
        Q<FRAC>::from_raw(raw: acc.downcast_saturate())
    } else {
        let half: i64 = 1 << ((FRAC as i64) - 1)
        let shifted: i64 = (acc + half) >> (FRAC as i64)
        Q<FRAC>::from_raw(raw: shifted.downcast_saturate())
    }
}

/// Apply a window to Q15 samples: `out[i] = samples[i] * coeffs[i]`
/// (each coefficient is a Q15 raw value, e.g. from `HANN16`).
/// Elementwise `sat_mul`, so no element can overflow.
pub fn window<const N: usize>(samples: [Q15; N], coeffs: [i32; N]) -> [Q15; N] {
    var out: [Q15; N] = [Q15::zero(); N]
    var i: usize = 0
    while i < N {
        out[i] = samples[i].sat_mul(other: Q15::from_raw(raw: coeffs[i]))
        i += 1
    }
    out
}
