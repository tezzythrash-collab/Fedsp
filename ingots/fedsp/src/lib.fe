/// Convert a Q-format value to another Q-format, rounding to nearest
/// (ties toward +inf, the same convention as `sat_mul`) and saturating
/// on overflow. Shifting left widens the value; shifting right drops
/// low bits with rounding. `convert_q` between equal formats is the
/// identity.
pub fn convert_q<const FROM: i32, const TO: i32>(x: Q<FROM>) -> Q<TO>
where FROM >= 0, FROM <= 31, TO >= 0, TO <= 31
{
    if FROM == TO {
        Q::from_raw(raw: x.raw())
    } else if FROM > TO {
        let d: i64 = (FROM - TO) as i64
        let half: i64 = 1 << (d - 1)
        let shifted: i64 = ((x.raw() as i64) + half) >> d
        Q::from_raw(raw: shifted.downcast_saturate())
    } else {
        let d: i64 = (TO - FROM) as i64
        let shifted: i64 = (x.raw() as i64) << d
        Q::from_raw(raw: shifted.downcast_saturate())
    }
}

/// Integer square root of a non-negative `i64`, rounded to nearest
/// (ties toward +inf), by Newton iteration. `x <= 0` returns `0`.
/// Used by `Q::sqrt` and `rms`. The iteration is monotone decreasing
/// from `x / 2 + 1`, so it always terminates; the rounding step compares
/// the remainder against the root (`r > s` rounds up), which never
/// overflows because `s <= sqrt(x)`.
pub fn isqrt_round(x: i64) -> i64 {
    if x <= 0 { return 0 }
    var y: i64 = x / 2 + 1
    var y_next: i64 = (y + x / y) / 2
    while y_next < y {
        y = y_next
        y_next = (y + x / y) / 2
    }
    let r: i64 = x - y * y
    if r > y { y + 1 } else { y }
}

/// Mean of a Q15 frame, rounding to nearest (ties toward +inf) and
/// saturating on overflow. The sum accumulates in `i64` with saturation.
pub fn mean<const N: usize>(x: [Q15; N]) -> Q15 {
    var acc: i64 = 0
    var i: usize = 0
    while i < N {
        acc = acc.saturating_add(x[i].raw() as i64)
        i += 1
    }
    let n: i64 = N.downcast_truncate()
    let q: i64 = acc / n
    let rem: i64 = acc % n
    // Round to nearest, ties toward +inf (same convention as sat_mul).
    // Positive: round up iff 2*rem >= n. Negative: round down iff
    // 2*(-rem) > n — a tie at exactly -0.5 stays at q (toward +inf).
    let rounded: i64 = if acc >= 0 {
        if rem >= (n + 1) / 2 { q + 1 } else { q }
    } else {
        if rem <= -((n / 2) + 1) { q - 1 } else { q }
    }
    Q15::from_raw(raw: rounded.downcast_saturate())
}

/// Energy of a Q15 frame: `dot(x, x)`, saturating like `dot`.
pub fn energy<const N: usize>(x: [Q15; N]) -> Q15 {
    dot(a: x, b: x)
}

/// Root-mean-square of a Q15 frame: the square root of the mean of the
/// squares, rounding to nearest. The sum of squares accumulates in `i64`
/// with saturation, so `rms` never reverts.
pub fn rms<const N: usize>(x: [Q15; N]) -> Q15 {
    var acc: i64 = 0
    var i: usize = 0
    while i < N {
        let r: i64 = x[i].raw() as i64
        acc = acc.saturating_add(r * r)
        i += 1
    }
    let n: i64 = N.downcast_truncate()
    let m: i64 = acc / n
    Q15::from_raw(raw: isqrt_round(x: m).downcast_saturate())
}

/// Second-order IIR (biquad) filter, transposed direct form II.
///
/// Coefficients and state are Q15; every multiply and add saturates, so
/// a filter can never revert, whatever the input. `step` updates the
/// state in place through a mutable borrow (`step(self: mut Self, ...)`),
/// the idiomatic Fe 26.5 pattern for stateful filters; the caller keeps
/// the filter in a `var` binding and calls `step` once per sample.
///
/// Transfer function: `H(z) = (b0 + b1 z^-1 + b2 z^-2) /
/// (1 + a1 z^-1 + a2 z^-2)`, with the recurrence
/// `y = b0*x + z1`, `z1 = b1*x - a1*y + z2`, `z2 = b2*x - a2*y`.
pub struct Biquad { b0: Q15, b1: Q15, b2: Q15, a1: Q15, a2: Q15, z1: Q15, z2: Q15 }

impl Biquad {
    /// Build a biquad from Q15 coefficients, state starting at zero.
    pub fn new(b0: Q15, b1: Q15, b2: Q15, a1: Q15, a2: Q15) -> Self {
        Self { b0, b1, b2, a1, a2, z1: Q15::zero(), z2: Q15::zero() }
    }

    /// Documented example: 2nd-order Butterworth lowpass, fc = 0.1 * fs.
    /// Coefficients (Q15 raw): b0 = 2210, b1 = 4421, b2 = 2210,
    /// a1 = -37453, a2 = 13527. DC gain is 1.0 (within rounding).
    pub fn lowpass_01() -> Self {
        Self::new(
            b0: Q15::from_raw(raw: 2210),
            b1: Q15::from_raw(raw: 4421),
            b2: Q15::from_raw(raw: 2210),
            a1: Q15::from_raw(raw: -37453),
            a2: Q15::from_raw(raw: 13527),
        )
    }

    /// One sample step: update the state in place and return the output.
    pub fn step(self: mut Self, x: Q15) -> Q15 {
        let y: Q15 = self.b0.sat_mul(other: x).sat_add(other: self.z1)
        let z1: Q15 = self
            .b1
            .sat_mul(other: x)
            .sat_sub(other: self.a1.sat_mul(other: y))
            .sat_add(other: self.z2)
        let z2: Q15 = self.b2.sat_mul(other: x).sat_sub(other: self.a2.sat_mul(other: y))
        self.z1 = z1
        self.z2 = z2
        y
    }

    /// Reset the state to zero, keeping the coefficients.
    pub fn reset(self: mut Self) {
        self.z1 = Q15::zero()
        self.z2 = Q15::zero()
    }
}

/// Finite-impulse-response filter: a tap delay line over the saturating
/// `dot` product. `step` updates the delay line in place through a
/// mutable borrow, the same pattern as `Biquad::step`.
pub struct Fir<const N: usize> { taps: [Q15; N], delay: [Q15; N] }

impl<const N: usize> Fir<N> {
    /// Build an FIR filter from Q15 taps, delay line starting at zero.
    pub fn new(taps: [Q15; N]) -> Self {
        Self { taps, delay: [Q15::zero(); N] }
    }

    /// One sample step: shift the delay line, then `dot(taps, delay)`.
    /// Returns the output sample.
    pub fn step(self: mut Self, x: Q15) -> Q15 {
        var d: [Q15; N] = [Q15::zero(); N]
        d[0] = x
        var i: usize = 1
        while i < N {
            d[i] = self.delay[i - 1]
            i += 1
        }
        self.delay = d
        dot(a: self.taps, b: d)
    }

    /// Reset the delay line to zero, keeping the taps.
    pub fn reset(self: mut Self) {
        self.delay = [Q15::zero(); N]
    }
}
