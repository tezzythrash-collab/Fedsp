/// Complex Q15 number: value = `(re + i * im) / 2^15`. The FFT works
/// on arrays of `Cplx`; every operation saturates componentwise, so a
/// complex multiply or add can never revert.
pub struct Cplx { re: Q15, im: Q15 }

/// `Cplx` is two plain 32-bit values: copying it is always safe, and
/// it is what lets fixed-size arrays of `Cplx` be built with repetition.
impl Copy for Cplx {}

impl Cplx {
    /// Build from real and imaginary Q15 parts.
    pub fn new(re: Q15, im: Q15) -> Self {
        Self { re, im }
    }

    /// Zero (0 + 0i).
    pub fn zero() -> Self {
        Self { re: Q15::zero(), im: Q15::zero() }
    }

    /// Real part as a Q15 value.
    pub fn re(self) -> Q15 {
        self.re
    }

    /// Imaginary part as a Q15 value.
    pub fn im(self) -> Q15 {
        self.im
    }

    /// A real-valued complex number (`im == 0`).
    pub fn from_re(re: Q15) -> Self {
        Self { re, im: Q15::zero() }
    }

    /// Saturating complex addition, componentwise.
    pub fn add(self, other: Self) -> Self {
        Self { re: self.re.sat_add(other: other.re), im: self.im.sat_add(other: other.im) }
    }

    /// Saturating complex subtraction, componentwise.
    pub fn sub(self, other: Self) -> Self {
        Self { re: self.re.sat_sub(other: other.re), im: self.im.sat_sub(other: other.im) }
    }

    /// Complex multiplication: `(a + bi)(c + di) = (ac - bd) +
    /// (ad + bc)i`, each product a `sat_mul`, each sum/difference
    /// saturating. Never reverts.
    pub fn mul(self, other: Self) -> Self {
        Self {
            re: self.re.sat_mul(other: other.re).sat_sub(other: self.im.sat_mul(other: other.im)),
            im: self.re.sat_mul(other: other.im).sat_add(other: self.im.sat_mul(other: other.re)),
        }
    }

    /// Complex conjugate: negate the imaginary part (saturating, so
    /// `conj` of an `i32::MIN` imaginary part gives `maximum()`).
    pub fn conj(self) -> Self {
        Self { re: self.re, im: self.im.sat_neg() }
    }

    /// `|self|^2` as a Q15 value: `re * re + im * im`, each product a
    /// `sat_mul`, the sum saturating. Exact while `|self| <= 256`
    /// (Q15 value); above that it saturates to `maximum()`.
    pub fn magnitude_squared(self) -> Q15 {
        self.re.sat_mul(other: self.re).sat_add(other: self.im.sat_mul(other: self.im))
    }

    /// `|self|` as a Q15 value: the square root of
    /// `magnitude_squared`, rounding to nearest. Exact while
    /// `|self| <= 256` (Q15 value); above that it saturates.
    pub fn magnitude(self) -> Q15 {
        self.magnitude_squared().sqrt()
    }
}

/// Divide an `i32` raw by `2^s`, rounding to nearest (ties toward
/// +inf, the same convention as `sat_mul`), saturating. `s <= 0`
/// returns the input unchanged. Used by the inverse FFT to scale by
/// `1 / N`.
fn div_pow2_round(x: i32, s: i32) -> i32 {
    if s <= 0 {
        x
    } else {
        let half: i64 = 1 << ((s as i64) - 1)
        let v: i64 = ((x as i64) + half) >> (s as i64)
        v.downcast_saturate()
    }
}

/// Iterative radix-2 decimation-in-time FFT core (unscaled) over Q15
/// complex samples. `tw_re` / `tw_im` are the full-length twiddle
/// tables (`W_N^k = exp(-2 * pi * i * k / N)`, Q15 raw); `rev` is the
/// bit-reversal permutation for size `N`.
///
/// Scaling: the forward FFT is **unscaled** — `X[k] = sum_n x[n] *
/// W_N^(k*n)`, so a bin magnitude can grow by up to `N` over the input
/// magnitude. For real audio inputs (`|x| <= 1.0` in Q15) the largest
/// bin is `N * 32768` raw, far inside `i32`; saturation only bites for
/// near-full-range `i32` raws (e.g. a DC frame of `maximum()`), and
/// then the butterfly's saturating adds clamp instead of reverting.
/// The inverse FFT scales by exactly `1 / N` (rounding divide), so
/// `ifft(fft(x)) == x` within 1 ulp.
fn fft_core<const N: usize>(
    x: [Cplx; N],
    tw_re: [i32; N],
    tw_im: [i32; N],
    rev: [usize; N],
) -> [Cplx; N] {
    var a: [Cplx; N] = [Cplx::zero(); N]
    var i: usize = 0
    while i < N {
        a[i] = x[rev[i]]
        i += 1
    }
    var len: usize = 2
    while len <= N {
        let half: usize = len / 2
        let step: usize = N / len
        var base: usize = 0
        while base < N {
            var j: usize = 0
            while j < half {
                let w = Cplx::new(
                    re: Q15::from_raw(raw: tw_re[j * step]),
                    im: Q15::from_raw(raw: tw_im[j * step]),
                )
                let t = w.mul(other: a[base + j + half])
                let u = a[base + j]
                a[base + j] = u.add(other: t)
                a[base + j + half] = u.sub(other: t)
                j += 1
            }
            base += len
        }
        len = len * 2
    }
    a
}

/// Inverse FFT core by the conjugate trick: `conj(fft(conj(x))) / N`.
/// `log_n` is `log2(N)`; the final scale divides each component by
/// `2^log_n` with rounding to nearest. See `fft_core` for the scaling
/// and saturation behavior.
fn ifft_core<const N: usize>(
    x: [Cplx; N],
    tw_re: [i32; N],
    tw_im: [i32; N],
    rev: [usize; N],
    log_n: i32,
) -> [Cplx; N] {
    var conj_in: [Cplx; N] = [Cplx::zero(); N]
    var i: usize = 0
    while i < N {
        conj_in[i] = x[i].conj()
        i += 1
    }
    let f = fft_core(x: conj_in, tw_re: tw_re, tw_im: tw_im, rev: rev)
    var out: [Cplx; N] = [Cplx::zero(); N]
    i = 0
    while i < N {
        let c = f[i].conj()
        out[i] = Cplx::new(
            re: Q15::from_raw(raw: div_pow2_round(x: c.re().raw(), s: log_n)),
            im: Q15::from_raw(raw: div_pow2_round(x: c.im().raw(), s: log_n)),
        )
        i += 1
    }
    out
}

/// 16-point FFT (unscaled forward transform). See `fft_core`.
pub fn fft16(x: [Cplx; 16]) -> [Cplx; 16] {
    fft_core(
        x: x,
        tw_re: TWIDDLE16_RE,
        tw_im: TWIDDLE16_IM,
        rev: BITREV16,
    )
}

/// 16-point inverse FFT. `ifft16(fft16(x)) == x` within 1 ulp.
pub fn ifft16(x: [Cplx; 16]) -> [Cplx; 16] {
    ifft_core(
        x: x,
        tw_re: TWIDDLE16_RE,
        tw_im: TWIDDLE16_IM,
        rev: BITREV16,
        log_n: 4,
    )
}

/// 32-point FFT (unscaled forward transform). See `fft_core`.
pub fn fft32(x: [Cplx; 32]) -> [Cplx; 32] {
    fft_core(
        x: x,
        tw_re: TWIDDLE32_RE,
        tw_im: TWIDDLE32_IM,
        rev: BITREV32,
    )
}

/// 32-point inverse FFT. `ifft32(fft32(x)) == x` within 1 ulp.
pub fn ifft32(x: [Cplx; 32]) -> [Cplx; 32] {
    ifft_core(
        x: x,
        tw_re: TWIDDLE32_RE,
        tw_im: TWIDDLE32_IM,
        rev: BITREV32,
        log_n: 5,
    )
}

/// 64-point FFT (unscaled forward transform). See `fft_core`.
pub fn fft64(x: [Cplx; 64]) -> [Cplx; 64] {
    fft_core(
        x: x,
        tw_re: TWIDDLE64_RE,
        tw_im: TWIDDLE64_IM,
        rev: BITREV64,
    )
}

/// 64-point inverse FFT. `ifft64(fft64(x)) == x` within 1 ulp.
pub fn ifft64(x: [Cplx; 64]) -> [Cplx; 64] {
    ifft_core(
        x: x,
        tw_re: TWIDDLE64_RE,
        tw_im: TWIDDLE64_IM,
        rev: BITREV64,
        log_n: 6,
    )
}

/// Magnitude spectrum: `|X[k]|` per bin, Q15. Exact while every bin
/// magnitude is `<= 256` (Q15 value); above that it saturates — for
/// real audio inputs (`|x| <= 1.0`) the largest bin is `N`, so this
/// never saturates at 16/32/64 points.
pub fn fft_magnitude<const N: usize>(x: [Cplx; N]) -> [Q15; N] {
    var out: [Q15; N] = [Q15::zero(); N]
    var i: usize = 0
    while i < N {
        out[i] = x[i].magnitude()
        i += 1
    }
    out
}
