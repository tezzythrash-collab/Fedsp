#[test]
fn fir_random() {
    // Random 8 taps over a random 16-sample input.
    var fir = Fir::new(
        taps: [
            Q15::from_raw(raw: -15725),
            Q15::from_raw(raw: -19116),
            Q15::from_raw(raw: 5617),
            Q15::from_raw(raw: -29162),
            Q15::from_raw(raw: 1424),
            Q15::from_raw(raw: 5426),
            Q15::from_raw(raw: 19561),
            Q15::from_raw(raw: 27226),
        ],
    )
    let input: [Q15; 16] = [
        Q15::from_raw(raw: -4787),
        Q15::from_raw(raw: 13243),
        Q15::from_raw(raw: -10376),
        Q15::from_raw(raw: 4998),
        Q15::from_raw(raw: 25803),
        Q15::from_raw(raw: 3012),
        Q15::from_raw(raw: -3227),
        Q15::from_raw(raw: 6632),
        Q15::from_raw(raw: 17422),
        Q15::from_raw(raw: -8654),
        Q15::from_raw(raw: -8912),
        Q15::from_raw(raw: 8273),
        Q15::from_raw(raw: 344),
        Q15::from_raw(raw: -27543),
        Q15::from_raw(raw: -23169),
        Q15::from_raw(raw: 26805),
    ]
    let out = run_fir(fir: mut fir, xs: input)
    assert_q15_frame(
        got: out,
        want: [
            2297,
            -3563,
            -3567,
            10185,
            -29071,
            -6624,
            -1349,
            -21320,
            -8705,
            -3236,
            26324,
            7232,
            3614,
            26153,
            33973,
            3818,
        ],
    )
}

#[test]
fn biquad_random() {
    // Random 16-sample input through the documented lowpass.
    let input: [Q15; 16] = [
        Q15::from_raw(raw: 5329),
        Q15::from_raw(raw: -23421),
        Q15::from_raw(raw: -25897),
        Q15::from_raw(raw: -5904),
