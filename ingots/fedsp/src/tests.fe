            4065,
            4747,
            2218,
            -1195,
            -2547,
            -2864,
            105,
            6289,
        ],
    )
}

#[test]
fn fft_random() {
    // Seeded random complex frames; the oracle cross-checked
    // each against an independent float DFT (<= 16 ulp).
    let x16 = to_cplx2(
        re: [
            Q15::from_raw(raw: 20304),
            Q15::from_raw(raw: -8328),
            Q15::from_raw(raw: 12076),
            Q15::from_raw(raw: -11242),
            Q15::from_raw(raw: 28604),
            Q15::from_raw(raw: 12436),
            Q15::from_raw(raw: -7100),
