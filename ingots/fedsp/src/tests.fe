#[test]
fn scalar_random() {
    // Seeded random raws (seed 20261120): sqrt, reciprocal,
    // and convert_q over 6 format pairs.
    assert!(Q15::from_raw(raw: -11622).sqrt().raw() == 0)
    assert!(Q15::from_raw(raw: -11622).reciprocal().raw() == -92388)
    assert!(Q15::from_raw(raw: 5698).sqrt().raw() == 13664)
    assert!(Q15::from_raw(raw: 5698).reciprocal().raw() == 188444)
    assert!(Q15::from_raw(raw: 4776).sqrt().raw() == 12510)
    assert!(Q15::from_raw(raw: 4776).reciprocal().raw() == 224820)
    assert!(Q15::from_raw(raw: 10410).sqrt().raw() == 18469)
    assert!(Q15::from_raw(raw: 10410).reciprocal().raw() == 103144)
    assert!(Q15::from_raw(raw: 11704).sqrt().raw() == 19584)
    assert!(Q15::from_raw(raw: 11704).reciprocal().raw() == 91742)
    assert!(Q15::from_raw(raw: -19774).sqrt().raw() == 0)
    assert!(Q15::from_raw(raw: -19774).reciprocal().raw() == -54301)
    assert!(Q15::from_raw(raw: 3503).sqrt().raw() == 10714)
    assert!(Q15::from_raw(raw: 3503).reciprocal().raw() == 306520)
    assert!(Q15::from_raw(raw: -20395).sqrt().raw() == 0)
    assert!(Q15::from_raw(raw: -20395).reciprocal().raw() == -52647)
    assert!(Q15::from_raw(raw: -18696).sqrt().raw() == 0)
    assert!(Q15::from_raw(raw: -18696).reciprocal().raw() == -57432)
    assert!(Q15::from_raw(raw: -25743).sqrt().raw() == 0)
    assert!(Q15::from_raw(raw: -25743).reciprocal().raw() == -41710)
    assert!(Q15::from_raw(raw: -63).sqrt().raw() == 0)
    assert!(Q15::from_raw(raw: -63).reciprocal().raw() == -17043456)
    assert!(Q15::from_raw(raw: -45).sqrt().raw() == 0)
    assert!(Q15::from_raw(raw: -45).reciprocal().raw() == -23860736)
    assert!(Q15::from_raw(raw: 98).sqrt().raw() == 1792)
    assert!(Q15::from_raw(raw: 98).reciprocal().raw() == 10956544)
    assert!(Q15::from_raw(raw: -597495732).sqrt().raw() == 0)
    assert!(Q15::from_raw(raw: -597495732).reciprocal().raw() == -2)
    assert!(Q15::from_raw(raw: -8539352).sqrt().raw() == 0)
    assert!(Q15::from_raw(raw: -8539352).reciprocal().raw() == -126)
    assert!(Q15::from_raw(raw: 1).sqrt().raw() == 181)
    assert!(Q15::from_raw(raw: 1).reciprocal().raw() == 1073725440)
    let c0: Q7 = convert_q(x: Q15::from_raw(raw: -11622))
    assert!(c0.raw() == -45)
    let c1: Q31 = convert_q(x: Q15::from_raw(raw: -11622))
    assert!(c1.raw() == -761659392)
    let c2: Q15 = convert_q(x: Q7::from_raw(raw: -11622))
    assert!(c2.raw() == -2975232)
    let c3: Q15 = convert_q(x: Q31::from_raw(raw: -11622))
    assert!(c3.raw() == 0)
    let c4: Q<0> = convert_q(x: Q15::from_raw(raw: -11622))
    assert!(c4.raw() == 0)
    let c5: Q15 = convert_q(x: Q<0>::from_raw(raw: -11622))
    assert!(c5.raw() == -380829696)
    let c6: Q7 = convert_q(x: Q15::from_raw(raw: 5698))
    assert!(c6.raw() == 22)
    let c7: Q31 = convert_q(x: Q15::from_raw(raw: 5698))
    assert!(c7.raw() == 373424128)
    let c8: Q15 = convert_q(x: Q7::from_raw(raw: 5698))
    assert!(c8.raw() == 1458688)
    let c9: Q15 = convert_q(x: Q31::from_raw(raw: 5698))
    assert!(c9.raw() == 0)
    let c10: Q<0> = convert_q(x: Q15::from_raw(raw: 5698))
    assert!(c10.raw() == 0)
    let c11: Q15 = convert_q(x: Q<0>::from_raw(raw: 5698))
    assert!(c11.raw() == 186712064)
    let c12: Q7 = convert_q(x: Q15::from_raw(raw: 4776))
    assert!(c12.raw() == 19)
    let c13: Q31 = convert_q(x: Q15::from_raw(raw: 4776))
    assert!(c13.raw() == 312999936)
    let c14: Q15 = convert_q(x: Q7::from_raw(raw: 4776))
    assert!(c14.raw() == 1222656)
    let c15: Q15 = convert_q(x: Q31::from_raw(raw: 4776))
    assert!(c15.raw() == 0)
    let c16: Q<0> = convert_q(x: Q15::from_raw(raw: 4776))
    assert!(c16.raw() == 0)
    let c17: Q15 = convert_q(x: Q<0>::from_raw(raw: 4776))
    assert!(c17.raw() == 156499968)
    let c18: Q7 = convert_q(x: Q15::from_raw(raw: 10410))
    assert!(c18.raw() == 41)
    let c19: Q31 = convert_q(x: Q15::from_raw(raw: 10410))
    assert!(c19.raw() == 682229760)
    let c20: Q15 = convert_q(x: Q7::from_raw(raw: 10410))
    assert!(c20.raw() == 2664960)
    let c21: Q15 = convert_q(x: Q31::from_raw(raw: 10410))
    assert!(c21.raw() == 0)
    let c22: Q<0> = convert_q(x: Q15::from_raw(raw: 10410))
    assert!(c22.raw() == 0)
    let c23: Q15 = convert_q(x: Q<0>::from_raw(raw: 10410))
    assert!(c23.raw() == 341114880)
    let c24: Q7 = convert_q(x: Q15::from_raw(raw: 11704))
    assert!(c24.raw() == 46)
    let c25: Q31 = convert_q(x: Q15::from_raw(raw: 11704))
    assert!(c25.raw() == 767033344)
    let c26: Q15 = convert_q(x: Q7::from_raw(raw: 11704))
    assert!(c26.raw() == 2996224)
    let c27: Q15 = convert_q(x: Q31::from_raw(raw: 11704))
    assert!(c27.raw() == 0)
    let c28: Q<0> = convert_q(x: Q15::from_raw(raw: 11704))
    assert!(c28.raw() == 0)
    let c29: Q15 = convert_q(x: Q<0>::from_raw(raw: 11704))
    assert!(c29.raw() == 383516672)
    let c30: Q7 = convert_q(x: Q15::from_raw(raw: -19774))
    assert!(c30.raw() == -77)
    let c31: Q31 = convert_q(x: Q15::from_raw(raw: -19774))
    assert!(c31.raw() == -1295908864)
    let c32: Q15 = convert_q(x: Q7::from_raw(raw: -19774))
    assert!(c32.raw() == -5062144)
    let c33: Q15 = convert_q(x: Q31::from_raw(raw: -19774))
    assert!(c33.raw() == 0)
    let c34: Q<0> = convert_q(x: Q15::from_raw(raw: -19774))
    assert!(c34.raw() == -1)
