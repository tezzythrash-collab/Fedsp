    assert!(spec_r[28].im().raw() == -225671)
    assert_parseval(x: sine1, spec: spec1)
}

#[test]
fn fft64_transform() {
    // Impulse -> flat spectrum; DC -> bin 0 is the sum (64 * 1.0).
    let spec_imp = fft64(x: impulse_cplx())
    assert!(spec_imp[0].re().raw() == 32768)
    assert!(spec_imp[63].re().raw() == 32768)
    assert!(spec_imp[40].im().raw() == 0)
    let spec_dc = fft64(x: dc_cplx())
    assert!(spec_dc[0].re().raw() == 2097152)
    assert!(spec_dc[1].re().raw() == 0)
    assert!(spec_dc[1].im().raw() == 0)
    // One-cycle sine: peaks at bins 1 and 63, magnitude 943673.
