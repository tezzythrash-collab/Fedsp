#[test]
fn demo_signal_chain() {
    // 16-sample sine burst, 2 cycles, amplitude 0.9 — the same burst
    // as demo_gain_stage, now run through the full v0.3.0 library:
    // Hann window -> 4-tap moving-average FIR -> Butterworth lowpass
    // biquad -> RMS / energy -> FFT magnitude.
    let burst: [Q15; 16] = [
        Q15::from_raw(raw: 0),
        Q15::from_raw(raw: 20853),
        Q15::from_raw(raw: 29490),
        Q15::from_raw(raw: 20853),
        Q15::from_raw(raw: 0),
        Q15::from_raw(raw: -20853),
        Q15::from_raw(raw: -29490),
        Q15::from_raw(raw: -20853),
        Q15::from_raw(raw: 0),
        Q15::from_raw(raw: 20853),
        Q15::from_raw(raw: 29490),
        Q15::from_raw(raw: 20853),
        Q15::from_raw(raw: 0),
        Q15::from_raw(raw: -20853),
        Q15::from_raw(raw: -29490),
        Q15::from_raw(raw: -20853),
    ]
    // Step 1: Hann window (spot-checks; the full frame is pinned in
    // demo_gain_stage).
    let windowed = window(samples: burst, coeffs: HANN16)
    assert!(windowed[1].raw() == 901)
    assert!(windowed[7].raw() == -20625)
    // Step 2: 4-tap moving-average FIR.
    var ma = Fir::new(
        taps: [
            Q15::from_raw(raw: 8192),
            Q15::from_raw(raw: 8192),
            Q15::from_raw(raw: 8192),
            Q15::from_raw(raw: 8192),
        ],
    )
    let fir_out = run_fir(fir: mut ma, xs: windowed)
    assert_q15_frame(
        got: fir_out,
        want: [
            0,
            225,
            1445,
            3246,
            3246,
            -889,
            -8777,
            -15734,
            -15734,
            -7109,
            5088,
            13124,
            13124,
            7546,
            1698,
            -1181,
        ],
    )
    // Step 3: Butterworth lowpass biquad (fc = 0.1 fs).
    var lp = Biquad::lowpass_01()
    let bq_out = run_biquad(bq: mut lp, xs: fir_out)
    assert_q15_frame(
        got: bq_out,
        want: [
            0,
            15,
            144,
            588,
            1367,
            1916,
            1133,
            -1801,
            -6302,
            -10123,
            -10645,
            -6896,
            -489,
            5453,
            8453,
            8069,
        ],
    )
    // Step 4: RMS and energy of the filtered output.
    assert!(rms(x: bq_out).raw() == 5477)
    assert!(energy(x: bq_out).raw() == 14649)
    // Step 5: FFT magnitude of the filtered output — the 2-cycle sine
    // peaks at bins 1 and 2 (the Hann window spreads it), with the
    // mirror image at bins 14 and 15.
    let spec = fft16(x: to_cplx(xs: bq_out))
    assert_cplx_frame(
        got: spec,
        want_re: [
            -9118,
            41809,
            -10646,
            -9028,
            -4509,
            -3978,
            -3714,
            -3595,
            -3560,
            -3595,
            -3714,
            -3978,
            -4509,
            -9028,
            -10646,
            41809,
        ],
        want_im: [
            0,
            -8059,
            41337,
            666,
            2699,
            1860,
            1163,
            559,
            0,
            -559,
            -1163,
            -1860,
            -2699,
            -666,
            -41337,
            8059,
        ],
    )
    assert_q15_frame(
        got: fft_magnitude(x: spec),
        want: [
            9118,
            42578,
            42686,
            9053,
            5253,
            4393,
            3891,
            3638,
            3561,
            3638,
            3891,
            4393,
            5253,
            9053,
            42686,
            42578,
        ],
    )
}
// --- v0.4.0 differential tests ----------------------------------------
// Seeded random inputs (seed 20261120, see tools/gen_vectors.py).
// Expected values transcribed from tools/vectors.json, never from
// Fe output.

#[test]
fn dot_random() {
    // Random 8- and 16-sample frames through the saturating dot.
    let a0: [Q15; 8] = [
        Q15::from_raw(raw: -940),
        Q15::from_raw(raw: 8333),
        Q15::from_raw(raw: 4022),
        Q15::from_raw(raw: -4665),
        Q15::from_raw(raw: -10755),
        Q15::from_raw(raw: 17108),
        Q15::from_raw(raw: -16046),
        Q15::from_raw(raw: 16622),
    ]
    let b0: [Q15; 8] = [
        Q15::from_raw(raw: -20887),
        Q15::from_raw(raw: -2639),
        Q15::from_raw(raw: -23045),
        Q15::from_raw(raw: -2188),
        Q15::from_raw(raw: -21224),
        Q15::from_raw(raw: 26374),
        Q15::from_raw(raw: -21726),
        Q15::from_raw(raw: -9761),
    ]
    assert!(dot(a: a0, b: b0).raw() == 23834)
    let a1: [Q15; 8] = [
        Q15::from_raw(raw: -15744),
        Q15::from_raw(raw: 28624),
        Q15::from_raw(raw: 606),
        Q15::from_raw(raw: -5922),
