    assert!(c35.raw() == -647954432)
    let c36: Q7 = convert_q(x: Q15::from_raw(raw: 3503))
    assert!(c36.raw() == 14)
    let c37: Q31 = convert_q(x: Q15::from_raw(raw: 3503))
    assert!(c37.raw() == 229572608)
    let c38: Q15 = convert_q(x: Q7::from_raw(raw: 3503))
    assert!(c38.raw() == 896768)
